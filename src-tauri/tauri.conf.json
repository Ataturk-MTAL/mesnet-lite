{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MESNET.Lite",
  "version": "0.1.1",
  "identifier": "ai.alplab.mesnet-lite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MESNET.Lite",
        "width": 1280,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Atatürk Mesleki ve Teknik Anadolu Lisesi",
    "copyright": "© 2026 Hakan Gülen — Apache-2.0",
    "license": "Apache-2.0",
    "category": "Education",
    "shortDescription": "İşletmelerde mesleki eğitim koordinatörlük dağıtımı",
    "longDescription": "İşletmelerde mesleki eğitim koordinatörlük dağıtımı, ek ders saati takdiri ve değişiklik tarihçesi.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
