<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store için MSIX paket bildirimi. `build-msix.ps1` @...@ yer
  tutucularını doldurur. Kimlik değerleri (Name, Publisher,
  PublisherDisplayName) Partner Center'da uygulama adı ayrıldıktan sonra
  "Ürün kimliği" sayfasından alınır ve depo değişkenlerinde tutulur.
  Store, gönderilen paketi kendi sertifikasıyla imzalar.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>MESNET.Lite</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809+; WebView2 çalışma zamanı Windows 11'de ve güncel Windows 10'da yüklüdür. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="tr-TR" />
  </Resources>

  <Applications>
    <Application Id="MESNETLite" Executable="mesnet-lite.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="MESNET.Lite"
        Description="İşletmelerde mesleki eğitim koordinatörlük dağıtımı ve ek ders saati takdiri"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <!-- Square310x310Logo verilirse Wide310x150Logo da zorunlu olur (MakeAppx 0x80080204); büyük kutucuk kullanılmıyor. -->
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Yalnız kullanıcı isteğiyle: Nominatim adres araması ve OpenStreetMap harita karoları. -->
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
